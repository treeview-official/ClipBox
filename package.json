{
  "name": "clipbox",
  "version": "1.1.0",
  "private": true,
  "description": "로컬에서 안전하게 사용하는 클립보드 기록 관리 앱",
  "author": "ClipBox",
  "homepage": "https://github.com/treeview-official/ClipBox#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/treeview-official/ClipBox.git"
  },
  "bugs": {
    "url": "https://github.com/treeview-official/ClipBox/issues"
  },
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "node scripts/dev.mjs",
    "start": "electron .",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "node scripts/e2e.mjs",
    "dist": "node scripts/dist.mjs",
    "make": "npm run dist",
    "pack": "node scripts/dist.mjs pack",
    "dist:win": "node scripts/dist.mjs win",
    "dist:mac": "node scripts/dist.mjs mac",
    "dist:linux": "node scripts/dist.mjs linux",
    "dist:linux:archive": "node scripts/dist.mjs linux-archive"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.5",
    "tar": "7.5.22",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vite": "8.3.5"
  },
  "overrides": {
    "@electron/get": "5.1.0"
  },
  "build": {
    "appId": "app.clipbox.desktop",
    "productName": "ClipBox",
    "directories": {
      "output": "release/1.1.0"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/icon.png",
      "package.json",
      "assets/trayTemplate.png",
      "assets/trayTemplate@2x.png"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": true,
      "artifactName": "ClipBox-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "ko_KR",
        "en_US"
      ]
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "target": [
        {
          "arch": [
            "x64",
            "arm64"
          ],
          "target": "dmg"
        },
        {
          "arch": [
            "x64",
            "arm64"
          ],
          "target": "zip"
        }
      ],
      "artifactName": "ClipBox-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "desktop": {
        "entry": {
          "Keywords": "Clipboard;History;Productivity;",
          "Comment": "Local clipboard history manager",
          "Name": "ClipBox"
        }
      },
      "maintainer": "treeview-official <220818056+treeview-official@users.noreply.github.com>",
      "syncDesktopName": true,
      "target": [
        "deb",
        "rpm"
      ],
      "executableName": "app.clipbox.desktop",
      "category": "Utility",
      "icon": "assets/linux",
      "artifactName": "ClipBox-${version}-linux-${arch}.${ext}"
    }
  },
  "desktopName": "app.clipbox.desktop.desktop"
}
